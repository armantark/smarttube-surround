+package com.liskovsoft.smartyoutubetv2.common.prefs;
+
+import android.content.Context;
+import com.liskovsoft.sharedutils.helpers.Helpers;
+import com.liskovsoft.smartyoutubetv2.common.R;
+import com.liskovsoft.smartyoutubetv2.common.app.models.playback.ui.OptionCategory;
+import com.liskovsoft.smartyoutubetv2.common.app.models.playback.ui.UiOptionItem;
+
+/**
+ * The "Stereo to rear speakers" player setting, on by default. It keeps its own key in the profile
+ * data, so upstream's index-based player data strings never shift under it.
+ */
+public final class StereoToRearSetting {
+    private static final String STEREO_TO_REAR_DATA = "stereo_to_rear_data";
+    private static final int CATEGORY_ID = 5100;
+
+    private StereoToRearSetting() {
+    }
+
+    public static boolean isEnabled(Context context) {
+        String data = AppPrefs.instance(context).getProfileData(STEREO_TO_REAR_DATA);
+        return Helpers.parseBoolean(Helpers.splitData(data), 0, true);
+    }
+
+    public static void setEnabled(Context context, boolean enabled) {
+        AppPrefs.instance(context).setProfileData(STEREO_TO_REAR_DATA, Helpers.mergeData(enabled));
+    }
+
+    /**
+     * A switch for the setting. The player builds its audio output with the setting, so {@code onChanged}
+     * restarts a playing video to apply a change.
+     */
+    public static OptionCategory createCategory(Context context, Runnable onChanged) {
+        return OptionCategory.from(CATEGORY_ID, OptionCategory.TYPE_SINGLE_SWITCH, null,
+                UiOptionItem.from(context.getString(R.string.stereo_to_rear_speakers), option -> {
+                    setEnabled(context, option.isSelected());
+                    onChanged.run();
+                }, isEnabled(context)));
+    }
+}
