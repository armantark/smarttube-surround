+package com.google.android.exoplayer2.audio;
+
+import androidx.annotation.Nullable;
+import com.google.android.exoplayer2.C;
+import com.google.android.exoplayer2.PlaybackParameters;
+import com.google.android.exoplayer2.util.Log;
+import com.google.android.exoplayer2.util.Util;
+import java.nio.ByteBuffer;
+
+/**
+ * Plays stereo from a soundbar's rear speakers as well as its front ones.
+ *
+ * <p>Some TVs send PCM to the soundbar in stereo only and more channels only as compressed audio,
+ * and the soundbar's own upmix puts only room sound in the rear speakers. This sink plays 16-bit
+ * stereo PCM as AAC-LC 5.1 with the left and right channels copied to the rear pair ({@link
+ * AacSurroundAudioSink}), when the output reports direct playback support for that format. Every
+ * other input, tunneled playback, and outputs without that support play through a {@link
+ * DefaultAudioSink} unchanged. So does stereo when the AAC output cannot open, so playback never
+ * goes silent.
+ */
+public final class StereoToRearAudioSink implements AudioSink {
+
+  private static final String TAG = "StereoToRear";
+
+  private final DefaultAudioSink defaultSink;
+  private final AacSurroundAudioSink surroundSink;
+  private AudioSink activeSink;
+  private AudioAttributes audioAttributes;
+  private boolean tunneling;
+
+  // The stereo format the surround sink was configured with, for the fallback to defaultSink.
+  private int sampleRate;
+  private int specifiedBufferSize;
+  private int trimStartFrames;
+  private int trimEndFrames;
+
+  /**
+   * @param audioCapabilities As for {@link DefaultAudioSink}.
+   * @param audioProcessors As for {@link DefaultAudioSink}. Both sinks share them: only the active
+   *     sink processes audio, and a sink is flushed before it goes inactive.
+   */
+  public StereoToRearAudioSink(
+      @Nullable AudioCapabilities audioCapabilities, AudioProcessor[] audioProcessors) {
+    defaultSink = new DefaultAudioSink(audioCapabilities, audioProcessors);
+    surroundSink = new AacSurroundAudioSink(audioProcessors);
+    activeSink = defaultSink;
+    audioAttributes = AudioAttributes.DEFAULT;
+  }
+
+  /** Returns the sink whose track supplies the playback clock, including the upstream path. */
+  public AudioSink getActiveSink() {
+    return activeSink;
+  }
+
+  @Override
+  public void setListener(Listener listener) {
+    defaultSink.setListener(listener);
+    surroundSink.setListener(listener);
+  }
+
+  @Override
+  public boolean supportsOutput(int channelCount, @C.Encoding int encoding) {
+    return defaultSink.supportsOutput(channelCount, encoding);
+  }
+
+  @Override
+  public long getCurrentPositionUs(boolean sourceEnded) {
+    return activeSink.getCurrentPositionUs(sourceEnded);
+  }
+
+  @Override
+  public void configure(
+      @C.Encoding int inputEncoding,
+      int inputChannelCount,
+      int inputSampleRate,
+      int specifiedBufferSize,
+      @Nullable int[] outputChannels,
+      int trimStartFrames,
+      int trimEndFrames)
+      throws ConfigurationException {
+    boolean isStereoPcm =
+        inputEncoding == C.ENCODING_PCM_16BIT && inputChannelCount == 2 && outputChannels == null;
+    if (!isStereoPcm || tunneling || Util.SDK_INT < 29) {
+      Log.i(TAG, "Default path for " + inputChannelCount + " channels, encoding " + inputEncoding
+          + (tunneling ? ", tunneled" : "") + ", API " + Util.SDK_INT);
+      activate(defaultSink);
+    } else if (!AacSurroundAudioSink.isSupported(inputSampleRate, audioAttributes)) {
+      Log.i(TAG, "Stereo at " + inputSampleRate + " Hz: no direct playback support for AAC-LC 5.1");
+      activate(defaultSink);
+    } else {
+      Log.i(TAG, "AAC-LC 5.1 at " + inputSampleRate + " Hz with the rear pair copying the front");
+      activate(surroundSink);
+      sampleRate = inputSampleRate;
+      this.specifiedBufferSize = specifiedBufferSize;
+      this.trimStartFrames = trimStartFrames;
+      this.trimEndFrames = trimEndFrames;
+    }
+    activeSink.configure(
+        inputEncoding,
+        inputChannelCount,
+        inputSampleRate,
+        specifiedBufferSize,
+        outputChannels,
+        trimStartFrames,
+        trimEndFrames);
+  }
+
+  @Override
+  public void play() {
+    defaultSink.play();
+    surroundSink.play();
+  }
+
+  @Override
+  public void handleDiscontinuity() {
+    activeSink.handleDiscontinuity();
+  }
+
+  @Override
+  public boolean handleBuffer(ByteBuffer buffer, long presentationTimeUs)
+      throws InitializationException, WriteException {
+    if (activeSink == surroundSink) {
+      try {
+        return surroundSink.handleBuffer(buffer, presentationTimeUs);
+      } catch (InitializationException e) {
+        // AacSurroundAudioSink logged the cause; InitializationException does not carry it.
+        Log.w(TAG, "AAC-LC 5.1 output did not open; playing stereo");
+        activate(defaultSink);
+        try {
+          defaultSink.configure(
+              C.ENCODING_PCM_16BIT, 2, sampleRate, specifiedBufferSize, null, trimStartFrames,
+              trimEndFrames);
+        } catch (ConfigurationException configurationException) {
+          throw new IllegalStateException(configurationException);
+        }
+      }
+    }
+    return defaultSink.handleBuffer(buffer, presentationTimeUs);
+  }
+
+  @Override
+  public void playToEndOfStream() throws WriteException {
+    activeSink.playToEndOfStream();
+  }
+
+  @Override
+  public boolean isEnded() {
+    return activeSink.isEnded();
+  }
+
+  @Override
+  public boolean hasPendingData() {
+    return activeSink.hasPendingData();
+  }
+
+  @Override
+  public PlaybackParameters setPlaybackParameters(PlaybackParameters playbackParameters) {
+    PlaybackParameters defaultSinkParameters = defaultSink.setPlaybackParameters(playbackParameters);
+    PlaybackParameters surroundSinkParameters =
+        surroundSink.setPlaybackParameters(playbackParameters);
+    return activeSink == surroundSink ? surroundSinkParameters : defaultSinkParameters;
+  }
+
+  @Override
+  public PlaybackParameters getPlaybackParameters() {
+    return activeSink.getPlaybackParameters();
+  }
+
+  @Override
+  public void setAudioAttributes(AudioAttributes audioAttributes) {
+    this.audioAttributes = audioAttributes;
+    defaultSink.setAudioAttributes(audioAttributes);
+    surroundSink.setAudioAttributes(audioAttributes);
+  }
+
+  @Override
+  public void setAudioSessionId(int audioSessionId) {
+    defaultSink.setAudioSessionId(audioSessionId);
+    surroundSink.setAudioSessionId(audioSessionId);
+  }
+
+  @Override
+  public void setAuxEffectInfo(AuxEffectInfo auxEffectInfo) {
+    defaultSink.setAuxEffectInfo(auxEffectInfo);
+  }
+
+  @Override
+  public void enableTunnelingV21(int tunnelingAudioSessionId) {
+    // The renderer enables tunneling before it configures the sink, so configure() routes the
+    // stream to defaultSink.
+    tunneling = true;
+    defaultSink.enableTunnelingV21(tunnelingAudioSessionId);
+  }
+
+  @Override
+  public void disableTunneling() {
+    tunneling = false;
+    defaultSink.disableTunneling();
+  }
+
+  @Override
+  public void setVolume(float volume) {
+    defaultSink.setVolume(volume);
+    surroundSink.setVolume(volume);
+  }
+
+  @Override
+  public void pause() {
+    defaultSink.pause();
+    surroundSink.pause();
+  }
+
+  @Override
+  public void flush() {
+    defaultSink.flush();
+    surroundSink.flush();
+  }
+
+  @Override
+  public void reset() {
+    defaultSink.reset();
+    surroundSink.reset();
+  }
+
+  private void activate(AudioSink sink) {
+    if (sink != activeSink) {
+      activeSink.flush();
+      activeSink = sink;
+    }
+  }
+}
