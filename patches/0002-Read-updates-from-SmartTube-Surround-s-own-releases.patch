From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: armantark <chuck67322@berkeley.edu>
Date: Sat, 17 Oct 2026 13:10:05 -0700
Subject: [PATCH 2/2] Read updates from SmartTube Surround's own releases

Upstream's beta manifest lists APKs signed with upstream's key under
upstream's package name, which the patched build cannot install over itself.
The patched build reads the manifest attached to this project's latest
release instead.
---
 common/src/stbeta/res/values/update_urls.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/common/src/stbeta/res/values/update_urls.xml b/common/src/stbeta/res/values/update_urls.xml
index 0242dc6ad..3ba118855 100644
--- a/common/src/stbeta/res/values/update_urls.xml
+++ b/common/src/stbeta/res/values/update_urls.xml
@@ -1,6 +1,6 @@
 <?xml version="1.0" encoding="utf-8"?>
 <resources>
     <string-array name="update_urls">
-        <item>https://github.com/yuliskov/SmartTubeNext/releases/download/latest/smarttube_beta2.json</item>
+        <item>https://github.com/armantark/smarttube-surround/releases/latest/download/smarttube_surround.json</item>
     </string-array>
 </resources>
\ No newline at end of file
